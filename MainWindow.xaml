<Window x:Class="PassFlowTotem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassFlow Totem"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Estilo de Botão de Toque Moderno -->
        <Style x:Key="TouchCardButton" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão Primário Azul -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- ========================================================================= -->
        <!-- 1. TELA DE PAREAMENTO (QUANDO O TOTEM AINDA NÃO ESTÁ VINCULADO)           -->
        <!-- ========================================================================= -->
        <Grid x:Name="PairingPanel" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="650">
                <!-- Branding -->
                <TextBlock Text="PASSFLOW TOTEM" Foreground="#3B82F6" FontSize="16" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Text="Pareamento de Autoatendimento" Foreground="#FFFFFF" FontSize="32" FontWeight="Bold" 
                           HorizontalAlignment="Center" Margin="0,0,0,14" />
                <TextBlock Text="Acesse o Painel Web (PassFlow Admin ➔ Gerenciar Telas / Dispositivos), clique em 'Vincular Totem' e digite o código de 6 dígitos abaixo:" 
                           Foreground="#94A3B8" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" 
                           LineHeight="24" Margin="0,0,0,30" />

                <!-- Caixa do Código PIN -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="2" CornerRadius="20" Padding="40,24" HorizontalAlignment="Center">
                    <TextBlock x:Name="TxtPairingPin" Text="------" Foreground="#60A5FA" FontSize="56" FontWeight="Black" 
                               FontFamily="Consolas, Courier New" HorizontalAlignment="Center" />
                </Border>

                <!-- Status de Busca -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <TextBlock Text="●" Foreground="#10B981" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtPairingStatus" Text="Aguardando confirmação do painel central..." Foreground="#64748B" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Botões de Configuração do Pareamento -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,35,0,0">
                    <Button Content="⚙️ Alterar Servidor" Click="BtnServerConfig_Click" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Padding="14,8" Cursor="Hand" Margin="0,0,10,0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button Content="🔄 Gerar Novo PIN" Click="BtnRefreshPin_Click" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#334155" BorderThickness="1" Padding="14,8" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 2. TELA PRINCIPAL DO TOTEM (PAREADO: SELEÇÃO DE SENHA EM ETAPAS)          -->
        <!-- ========================================================================= -->
        <Grid x:Name="KioskPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="90" />  <!-- Cabeçalho -->
                <RowDefinition Height="*" />   <!-- Conteúdo Principal -->
                <RowDefinition Height="70" />  <!-- Rodapé / Navegação -->
            </Grid.RowDefinitions>

            <!-- CABEÇALHO DO TOTEM -->
            <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="32,0">
                <Grid VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Identidade da Empresa / Unidade (5 cliques para abrir Admin) -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" MouseLeftButtonDown="Logo_MouseLeftButtonDown" Cursor="Hand">
                        <TextBlock x:Name="TxtOrgName" Text="PassFlow Atendimento" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="TxtUnitName" Text="Unidade Matriz" Foreground="#38BDF8" FontSize="13" Margin="0,2,0,0" />
                    </StackPanel>

                    <!-- Indicador de Etapa / Stepper Central -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStepTitle" Text="Passo 1: Selecione a Categoria" Foreground="#F8FAFC" FontSize="20" FontWeight="SemiBold" />
                    </StackPanel>

                    <!-- Relógio Digital em Tempo Real -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="TxtClock" Text="00:00:00" Foreground="#E2E8F0" FontSize="22" FontWeight="Bold" FontFamily="Consolas, Segoe UI" HorizontalAlignment="Right" />
                        <TextBlock Text="Toque na tela para selecionar" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- CONTEÚDO DINÂMICO (PASSOS: CATEGORIA -> SERVIÇO -> TIPO DE ATENDIMENTO) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="40">
                <Grid HorizontalAlignment="Center" MaxWidth="1200">
                    
                    <!-- ETAPA 1: CATEGORIAS -->
                    <WrapPanel x:Name="PanelCategories" Visibility="Visible" HorizontalAlignment="Center" ItemWidth="340" ItemHeight="220" Margin="-10" />

                    <!-- ETAPA 2: SERVIÇOS -->
                    <WrapPanel x:Name="PanelServices" Visibility="Collapsed" HorizontalAlignment="Center" ItemWidth="340" ItemHeight="200" Margin="-10" />

                    <!-- ETAPA 3: SUBSERVIÇOS -->
                    <WrapPanel x:Name="PanelSubServices" Visibility="Collapsed" HorizontalAlignment="Center" ItemWidth="340" ItemHeight="180" Margin="-10" />

                    <!-- ETAPA 4: TIPO DE ATENDIMENTO (CONVENCIONAL VS PREFERENCIAL) -->
                    <StackPanel x:Name="PanelTicketTypes" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Width="900" Margin="0,20,0,0">
                        <TextBlock Text="Qual a sua prioridade de atendimento?" Foreground="#FFFFFF" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,8" />
                        <TextBlock Text="Selecione abaixo conforme previsto na Lei Federal nº 10.048/2000" Foreground="#94A3B8" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,40" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- BOTÃO ATENDIMENTO NORMAL -->
                            <Button Grid.Column="0" Height="260" Style="{StaticResource TouchCardButton}" Click="BtnNormalTicket_Click">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="54" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                    <TextBlock Text="CONVENCIONAL" FontSize="26" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    <TextBlock Text="Atendimento padrão por ordem de chegada" FontSize="13" Foreground="#94A3B8" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </Button>

                            <!-- BOTÃO ATENDIMENTO PREFERENCIAL -->
                            <Button Grid.Column="2" Height="260" Style="{StaticResource TouchCardButton}" Click="BtnPriorityTicket_Click" BorderBrush="#F59E0B">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="⭐" FontSize="54" HorizontalAlignment="Center" Margin="0,0,0,14" />
                                    <TextBlock Text="PRIORITÁRIO" FontSize="26" FontWeight="Black" Foreground="#F59E0B" HorizontalAlignment="Center" />
                                    <TextBlock Text="Idosos (60+), Gestantes, PCD, Pessoas com Crianças de Colo e TEA" FontSize="12" Foreground="#CBD5E1" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- RODAPÉ DE NAVEGAÇÃO -->
            <Border Grid.Row="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,1,0,0" Padding="32,0">
                <Grid VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Content="⬅ Voltar" Click="BtnBack_Click" Background="#334155" Foreground="#FFFFFF" FontWeight="SemiBold" Padding="20,12" HorizontalAlignment="Left" Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button x:Name="BtnCancel" Content="❌ Cancelar e Iniciar Novamente" Click="BtnCancel_Click" Background="#334155" Foreground="#94A3B8" Padding="16,10" HorizontalAlignment="Right" Visibility="Collapsed">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="10"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 3. TELA DE SUCESSO / IMPRESSÃO EM ANDAMENTO                               -->
        <!-- ========================================================================= -->
        <Grid x:Name="SuccessPanel" Visibility="Collapsed" Background="#0F172A">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="600">
                <!-- Ícone de Sucesso -->
                <Border Background="#065F46" Width="100" Height="100" CornerRadius="50" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="✓" Foreground="#34D399" FontSize="56" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="SENHA EMITIDA COM SUCESSO!" Foreground="#34D399" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" />
                <TextBlock Text="Por favor, retire seu comprovante impresso." Foreground="#94A3B8" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,32" />

                <!-- Card de Destaque da Senha -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="2" CornerRadius="20" Padding="40,30" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SUA SENHA:" Foreground="#94A3B8" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock x:Name="TxtSuccessTicketNumber" Text="---" Foreground="#38BDF8" FontSize="64" FontWeight="Black" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <TextBlock x:Name="TxtSuccessService" Text="Serviço" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TxtSuccessType" Text="[CONVENCIONAL]" Foreground="#F59E0B" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Feedback de Impressão -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                    <TextBlock Text="🖨️ Imprimindo na impressora padrão..." Foreground="#64748B" FontSize="14" HorizontalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- 4. MODAL DE CONFIGURAÇÃO / ADMIN (Ctrl+Alt+S ou F12)                     -->
        <!-- ========================================================================= -->
        <Grid x:Name="AdminModal" Visibility="Collapsed" Background="#80000000">
            <Border Background="#1E293B" BorderBrush="#475569" BorderThickness="2" CornerRadius="16" Width="520" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="⚙️ Configurações do Totem" Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock Text="Ajuste o endereço de comunicação e a impressora térmica." Foreground="#94A3B8" FontSize="13" Margin="0,0,0,24" />

                    <!-- Servidor -->
                    <TextBlock Text="Endereço do Servidor PassFlow:" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="TxtServerInput" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" Padding="12,10" FontSize="14" Margin="0,0,0,18" />

                    <!-- Impressora -->
                    <TextBlock Text="Impressora Térmica Selecionada:" Foreground="#CBD5E1" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="CmbPrinters" Background="#0F172A" Foreground="#FFFFFF" BorderBrush="#334155" Padding="10,8" FontSize="13" Margin="0,0,0,24" />

                    <!-- Ações -->
                    <Button Content="🖨️ Testar Impressão de Cupom" Click="BtnTestPrint_Click" Background="#334155" Foreground="#FFFFFF" Padding="14,10" Margin="0,0,0,10">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="⚠️ Desvincular Totem (Resetar Pareamento)" Click="BtnUnpair_Click" Background="#7F1D1D" Foreground="#FECACA" Padding="14,10" Margin="0,0,0,24">
                        <Button.Resources>
                            <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
                        </Button.Resources>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Click="BtnCloseAdmin_Click" Background="Transparent" Foreground="#94A3B8" Padding="16,10" Margin="0,0,12,0" />
                        <Button Content="Salvar Configurações" Click="BtnSaveAdmin_Click" Style="{StaticResource PrimaryButton}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
